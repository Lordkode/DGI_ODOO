# Copier ce fichier en .env puis renseigner de vraies valeurs.
# .env est ignoré par git (voir .gitignore) - ne jamais committer de vrais identifiants.

# --- Variables PostgreSQL ---
POSTGRES_DB=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_USER=odoo
PGDATA=/var/lib/postgresql/data/pgdata

# --- Variables Odoo (connexion à PostgreSQL) ---
HOST=postgres
USER=odoo
PASSWORD=change-me
