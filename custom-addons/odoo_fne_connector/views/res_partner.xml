<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_form_partner_inherit_fne" model="ir.ui.view">
            <field name="name">form.partner.inherit.fne</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
               <xpath expr="//field[@name='vat']" position="after">
                <field name="fne_company_enabled" invisible="1"/>
                <field name="templateFne" invisible="not fne_company_enabled"/>
                <field name="regimeFiscal" invisible="not fne_company_enabled"/>
            </xpath>
            </field>
        </record>
    </data>
</odoo>